# 临时/中间产物,不入库

# Python
__pycache__/
*.pyc
*.pyo

# Excel 临时锁文件(打开 xlsx 时生成)
~$*.xlsx
~$*.xls

# 钉钉同步/源料 中间产物(每次任务期短期使用,不进版本)
output/dingtalk-sync/
output/dingtalk-source/
output/scripts/
examples/*/output/dingtalk-sync/
examples/*/output/dingtalk-source/

# 本地 diff/调试临时目录
.diff-tmp/

# 测试配置生成失败时的备用产物
examples/*/output/test-config/ActivitySoccer_preview.generated.xlsx
examples/*/output/test-config/ActivitySoccerLanguage.generated.xlsx

# 关卡 tag 工具产物(由 apply_level_tags.py 生成)
examples/*/output/test-config/level-tags/ActivitySoccer.LevelTagged.generated.xlsx
examples/*/output/test-config/level-tags/level-tag-summary.json
